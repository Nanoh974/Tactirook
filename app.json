{
  "expo": {
    "name": "Tactirook",
    "slug": "tactirook",
    "version": "1.0.0",
    "icon": "./assets/icon-app.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "baseUrl": "/Tactirook"
    },
    "plugins": [
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "fr", "es", "ja", "zh-Hans", "hi", "it"]
        }
      ]
    ]
  }
}
